# ================= 应用 =================
NODE_ENV=development
APP_PORT=3000
# 监听地址：默认 127.0.0.1（只允许本机 Nginx 反代访问）。
# 仅在需要被外部直接访问的临时联调场景才改成 0.0.0.0，且必须同步收紧安全组。
APP_HOST=127.0.0.1
# 全局接口前缀下的日志级别：error,warn,log,debug,verbose
APP_LOG_LEVEL=log
# 应用层 IP 白名单总开关（默认开启）。语义 fail-closed：**只有显式写 false 才关闭**，
# 未配置或写错值一律按开启处理（写错值若按关闭算，一次手误就等于把后台敞开）。
# ⚠️ 本开关只管应用层；Nginx 的 allow/deny 在 /etc/nginx/conf.d/zhiban-admin-allow.inc，需另行同步
ADMIN_IP_WHITELIST_ENABLED=true
# 允许的管理后台来源（逗号分隔，可混用精确地址与 CIDR 网段）
# 例：1.2.3.4,10.0.0.0/8,2001:db8::/32
# 与 Nginx 的 allow/deny 构成双层防线（Nginx 为主防线，ADR-003 决策 3）
# fail-closed：生产环境留空 → 后台接口全部拒绝并在启动时打 error 日志（非生产环境留空则放行）
ADMIN_ALLOWED_IPS=

# ================= 鉴权 =================
# 微信登录态签发 JWT 的密钥（模块 2 使用；生产必须改为强随机值）
JWT_SECRET=dev_only_change_me
JWT_EXPIRES_IN=30d

# 管理后台 JWT 独立密钥（模块 8，ADR-003 决策 2）
# 生成方式：openssl rand -hex 32
# 约束：生产必填、长度 >= 32、且不得与 JWT_SECRET 相同（env.validation 会强制校验）
ADMIN_JWT_SECRET=
# 后台登录态有效期（比小程序短：后台是高权限入口）
ADMIN_JWT_EXPIRES_IN=8h
# 后台登录限流：按来源 IP 计数（防口令爆破）
ADMIN_LOGIN_WINDOW_MS=300000
ADMIN_LOGIN_IP_MAX=10

# ================= MySQL =================
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=zhiban
DB_PASSWORD=zhiban123456
DB_DATABASE=zhiban
# 生产严禁开启（表结构由 docs/schema.sql 管理，安全基线 §4）
DB_SYNCHRONIZE=false
DB_LOGGING=false

# ================= Redis =================
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=zhiban123456
REDIS_DB=0
# 会话/草稿/队列共用，键前缀隔离
REDIS_KEY_PREFIX=zhiban:

# ================= 限流（边界总表 F5 / C8） =================
# 默认：单身份 60 秒内 120 次
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120
# 邀请码查询接口更严（C8 防枚举）：60 秒内 20 次
RATE_LIMIT_INVITE_WINDOW_MS=60000
RATE_LIMIT_INVITE_MAX=20
# 登录接口双维度限流（A5 防刷）：IP 维度放宽（同一出口 IP 可能有多个真实用户）
RATE_LIMIT_LOGIN_WINDOW_MS=60000
RATE_LIMIT_LOGIN_IP_MAX=60
# openid 维度收紧（防单账号刷登录 / 刷微信内容安全配额）
RATE_LIMIT_LOGIN_OPENID_MAX=20

# ================= 微信小程序（模块 2 使用） =================
WX_APPID=
WX_SECRET=
WX_SUBSCRIBE_TEMPLATE_INVITE=
# 模拟登录（仅本地/联调，生产强制忽略且启动校验会直接报错）：
# 开启后任意 code 均可登录，用于未拿到小程序凭证前打通登录链路自测
WX_MOCK_LOGIN=false

# ================= 大模型（模块 7 专属卡生成） =================
# 供应商取 DeepSeek（ADR-007 决策 3），走 OpenAI 兼容协议，不引入厂商 SDK
LLM_API_BASE=https://api.deepseek.com/v1
# 只存本文件（服务器 /opt/zhiban/server/.env），禁止入库、禁止下发端上
# 留空 = 未配置：专属卡接口直接返回降级结果，不报错、不阻塞内容浏览
LLM_API_KEY=
LLM_MODEL=deepseek-chat

# ================= 支付与权益（模块 6，ADR-007 决策 1） =================
# 网关实现：free（P1 默认，下单即到账，不生成支付参数）/ mock（联调演练）/ wechat（P2 真实商户号）
# 非法取值启动即拒绝；mock 在生产被强制拒绝；wechat 缺任一 WXPAY_* 启动即拒绝
PAYMENT_GATEWAY=free
# 未支付订单超时关闭（E3：保留期，超时置 closed，用户可重新下单）
PAYMENT_ORDER_EXPIRE_MINUTES=30
# 兑换码有效期天数（E8）
PAYMENT_COUPON_EXPIRE_DAYS=7
# mock 网关的回调验签密钥（PAYMENT_GATEWAY=mock 时必填；生产启用 mock 会被拒绝启动）
PAYMENT_MOCK_SIGN_KEY=

# 微信支付 V3（PAYMENT_GATEWAY=wechat 时 6 项全部必填，缺失则启动即失败）
WXPAY_MCH_ID=
# APIv3 密钥（用于回调解密 AES-256-GCM），32 位
WXPAY_API_V3_KEY=
# 商户证书序列号
WXPAY_SERIAL_NO=
# 商户私钥文件路径（apiclient_key.pem），服务器上的绝对路径
WXPAY_PRIVATE_KEY_PATH=
# 微信支付平台证书路径（用于回调验签），服务器上的绝对路径
WXPAY_PLATFORM_CERT_PATH=
# 支付结果通知地址：https://m.arvine.cn/api/v1/pay/notify
WXPAY_NOTIFY_URL=

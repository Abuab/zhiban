# ================= 应用 =================
NODE_ENV=development
APP_PORT=3000
# 监听地址：默认 127.0.0.1（只允许本机 Nginx 反代访问）。
# 仅在需要被外部直接访问的临时联调场景才改成 0.0.0.0，且必须同步收紧安全组。
APP_HOST=127.0.0.1
# 全局接口前缀下的日志级别：error,warn,log,debug,verbose
APP_LOG_LEVEL=log
# 允许的管理后台来源 IP（逗号分隔，如 1.2.3.4,5.6.7.8）
# 与 deploy/nginx/zhiban.arvine.cn.conf 的 allow/deny 构成双层防线（Nginx 为主防线，ADR-003 决策 3）
# fail-closed：生产环境留空 → 后台接口全部拒绝并在启动时打 error 日志（非生产环境留空则放行）
ADMIN_ALLOWED_IPS=

# ================= 鉴权 =================
# 微信登录态签发 JWT 的密钥（模块 2 使用；生产必须改为强随机值）
JWT_SECRET=dev_only_change_me
JWT_EXPIRES_IN=30d

# 管理后台 JWT 独立密钥（模块 8，ADR-003 决策 2）
# 生成方式：openssl rand -hex 32
# 约束：生产必填、长度 >= 32、且不得与 JWT_SECRET 相同（env.validation 会强制校验）
ADMIN_JWT_SECRET=
# 后台登录态有效期（比小程序短：后台是高权限入口）
ADMIN_JWT_EXPIRES_IN=8h
# 后台登录限流：按来源 IP 计数（防口令爆破）
ADMIN_LOGIN_WINDOW_MS=300000
ADMIN_LOGIN_IP_MAX=10

# ================= MySQL =================
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=zhiban
DB_PASSWORD=zhiban123456
DB_DATABASE=zhiban
# 生产严禁开启（表结构由 docs/schema.sql 管理，安全基线 §4）
DB_SYNCHRONIZE=false
DB_LOGGING=false

# ================= Redis =================
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=zhiban123456
REDIS_DB=0
# 会话/草稿/队列共用，键前缀隔离
REDIS_KEY_PREFIX=zhiban:

# ================= 限流（边界总表 F5 / C8） =================
# 默认：单身份 60 秒内 120 次
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120
# 邀请码查询接口更严（C8 防枚举）：60 秒内 20 次
RATE_LIMIT_INVITE_WINDOW_MS=60000
RATE_LIMIT_INVITE_MAX=20
# 登录接口双维度限流（A5 防刷）：IP 维度放宽（同一出口 IP 可能有多个真实用户）
RATE_LIMIT_LOGIN_WINDOW_MS=60000
RATE_LIMIT_LOGIN_IP_MAX=60
# openid 维度收紧（防单账号刷登录 / 刷微信内容安全配额）
RATE_LIMIT_LOGIN_OPENID_MAX=20

# ================= 微信小程序（模块 2 使用） =================
WX_APPID=
WX_SECRET=
WX_SUBSCRIBE_TEMPLATE_INVITE=
# 模拟登录（仅本地/联调，生产强制忽略且启动校验会直接报错）：
# 开启后任意 code 均可登录，用于未拿到小程序凭证前打通登录链路自测
WX_MOCK_LOGIN=false

# ================= 大模型（模块 7 专属卡生成） =================
LLM_API_BASE=
LLM_API_KEY=
LLM_MODEL=

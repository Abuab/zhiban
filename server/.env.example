# ================= 应用 =================
NODE_ENV=development
APP_PORT=3000
# 全局接口前缀下的日志级别：error,warn,log,debug,verbose
APP_LOG_LEVEL=log
# 允许的管理后台来源（生产由 Nginx 白名单兜底，见 docs/architecture.md §6）
ADMIN_ALLOWED_IPS=

# ================= 鉴权 =================
# 微信登录态签发 JWT 的密钥（模块 2 使用；生产必须改为强随机值）
JWT_SECRET=dev_only_change_me
JWT_EXPIRES_IN=30d

# ================= MySQL =================
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=zhiban
DB_PASSWORD=zhiban123456
DB_DATABASE=zhiban
# 生产严禁开启（表结构由 docs/schema.sql 管理，安全基线 §4）
DB_SYNCHRONIZE=false
DB_LOGGING=false

# ================= Redis =================
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=zhiban123456
REDIS_DB=0
# 会话/草稿/队列共用，键前缀隔离
REDIS_KEY_PREFIX=zhiban:

# ================= 限流（边界总表 F5 / C8） =================
# 默认：单身份 60 秒内 120 次
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120
# 邀请码查询接口更严（C8 防枚举）：60 秒内 20 次
RATE_LIMIT_INVITE_WINDOW_MS=60000
RATE_LIMIT_INVITE_MAX=20

# ================= 微信小程序（模块 2 使用） =================
WX_APPID=
WX_SECRET=
WX_SUBSCRIBE_TEMPLATE_INVITE=

# ================= 大模型（模块 7 专属卡生成） =================
LLM_API_BASE=
LLM_API_KEY=
LLM_MODEL=

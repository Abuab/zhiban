{
  "name": "zhiban-miniprogram",
  "version": "0.1.0",
  "private": true,
  "description": "小程序端（uni-app + Vue3 + TypeScript，编译目标：微信小程序）",
  "scripts": {
    "predev:mp-weixin": "node scripts/inject-brand.mjs --mode development",
    "dev:mp-weixin": "uni -p mp-weixin",
    "prebuild:mp-weixin": "node scripts/inject-brand.mjs --mode production",
    "build:mp-weixin": "uni build -p mp-weixin",
    "predev:h5": "node scripts/inject-brand.mjs --mode development",
    "dev:h5": "uni",
    "prebuild:h5": "node scripts/inject-brand.mjs --mode production",
    "build:h5": "uni build",
    "type-check": "vue-tsc --noEmit"
  },
  "dependencies": {
    "@dcloudio/uni-app": "3.0.0-5020620260917001",
    "@dcloudio/uni-components": "3.0.0-5020620260917001",
    "@dcloudio/uni-h5": "3.0.0-5020620260917001",
    "@dcloudio/uni-mp-weixin": "3.0.0-5020620260917001",
    "vue": "3.4.21"
  },
  "devDependencies": {
    "@dcloudio/types": "3.4.31",
    "@dcloudio/uni-cli-shared": "3.0.0-5020620260917001",
    "@dcloudio/vite-plugin-uni": "3.0.0-5020620260917001",
    "@vue/runtime-core": "3.4.21",
    "sass": "^1.77.0",
    "typescript": "^5.4.2",
    "vite": "5.2.8",
    "vue-tsc": "^2.0.6"
  }
}

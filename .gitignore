# 依赖
node_modules/
.pnpm-store/

# 构建产物
dist/
build/
unpackage/
coverage/

# 环境变量（密钥禁止入库，安全基线 §4）
.env
.env.local
.env.*.local
# 例外：小程序端 .env 只放品牌展示配置（无任何密钥，且是品牌名的唯一真源，ADR-002）
!miniprogram/.env
# 例外：管理后台 .env 只放接口前缀与本地调试代理地址（无任何密钥，ADR-003）
!admin/.env

# 后台 IP 白名单属部署期信息（随运维地点变化），仓库只留 .example 模板（ADR-003 决策 3）
deploy/nginx/zhiban-admin-allow.inc

# 用户上传内容（客服二维码等公开物料）：不入库，由部署机本地保留（ADR-010 决策 5）
uploads/

# 日志
logs/
*.log
npm-debug.log*

# 编辑器与系统
.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json

# 运行时
*.pid
*.seed
*.tsbuildinfo

# 小程序开发者工具
project.private.config.json
